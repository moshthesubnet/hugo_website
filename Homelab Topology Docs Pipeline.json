    {
      "parameters": {
        "jsCode": "const state = {\n  collected_at: new Date().toISOString(),\n  source: 'opnsense',\n  data: {\n    interfaces: {},\n    aliases: {},\n    routes: {},\n    dhcp_leases: {}\n  }\n};\n\ntry { state.data.interfaces = $('OPNsense: Get Interfaces').first().json; } catch(e) {}\ntry { state.data.aliases = $('OPNsense: Get Aliases').first().json; } catch(e) {}\ntry { state.data.routes = $('OPNsense: Get Routes').first().json; } catch(e) {}\ntry { state.data.dhcp_leases = $('OPNsense: Get DHCP Leases').first().json; } catch(e) {}\n\nreturn [{ json: state }];"
      },
      "id": "348c9ee8-d4e8-405c-bd22-e5b51980162f",
      "name": "Build State Object",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        16
      ]
    },
    {
      "parameters": {
        "fileSelector": "/vault/homelab/topology/devices/opnsense-state.json",
        "options": {}
      },
      "id": "114f4d7d-b9d5-41f0-8957-01191ab613b1",
      "name": "Read Previous State",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        608,
        272
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Compare current state with previous state to find changes\nconst current = $('Build State Object').first().json;\nlet previous = null;\n\ntry {\n  const prevData = $('Read Previous State').first();\n  if (prevData && prevData.json && prevData.json.data) {\n    previous = prevData.json;\n  }\n} catch (e) {\n  // No previous state exists, treat everything as new\n}\n\nconst diff = {\n  has_changes: false,\n  is_first_run: !previous,\n  changes: [],\n  current_state: current,\n  previous_collected_at: previous?.collected_at || null\n};\n\nif (!previous) {\n  diff.has_changes = true;\n  diff.changes.push('Initial topology scan — no previous state found');\n} else {\n  // Compare interfaces\n  const currIfaces = JSON.stringify(current.data.interfaces);\n  const prevIfaces = JSON.stringify(previous.data.interfaces);\n  if (currIfaces !== prevIfaces) {\n    diff.has_changes = true;\n    diff.changes.push('Interface configuration changed');\n  }\n\n  // Compare aliases\n  const currAliases = JSON.stringify(current.data.aliases);\n  const prevAliases = JSON.stringify(previous.data.aliases);\n  if (currAliases !== prevAliases) {\n    diff.has_changes = true;\n    diff.changes.push('Firewall aliases changed');\n  }\n\n  // Compare routes\n  const currRoutes = JSON.stringify(current.data.routes);\n  const prevRoutes = JSON.stringify(previous.data.routes);\n  if (currRoutes !== prevRoutes) {\n    diff.has_changes = true;\n    diff.changes.push('Routing table changed');\n  }\n\n  // Compare DHCP\n  const currDhcp = JSON.stringify(current.data.dhcp_leases);\n  const prevDhcp = JSON.stringify(previous.data.dhcp_leases);\n  if (currDhcp !== prevDhcp) {\n    diff.has_changes = true;\n    diff.changes.push('DHCP leases changed');\n  }\n}\n\nreturn [{ json: diff }];"
      },
      "id": "137bfbee-77ad-44d5-9b6e-3e38afe58b0f",
      "name": "Diff: Detect Changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
