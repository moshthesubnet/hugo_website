        "jsCode": "const fs = require('fs');\nconst entry = $('Build Changelog Entry').first().json.entry;\n\nfs.appendFileSync('/vault/homelab/topology/changelog.md', entry, 'utf8');\n\nreturn $input.all();"
      },
