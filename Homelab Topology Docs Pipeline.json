      "id": "6dc48765-0c92-4c5b-979a-233fb9ab8809",
      "name": "Append Changelog"
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\n\nfor (const item of $input.all()) {\n  const filePath = `/vault/homelab/topology/devices/${item.json.filename}`;\n  fs.writeFileSync(filePath, item.json.content, 'utf8');\n}\n\nreturn $input.all();"
      },
