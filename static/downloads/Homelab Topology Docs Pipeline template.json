    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst entry = $('Build Changelog Entry').first().json.entry;\n\nfs.appendFileSync('/path/to/vault/changelog.md', entry, 'utf8');\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2192,
        336
      ],
      "id": "4c41ba0c-b511-4321-9139-338da9aec381",
      "name": "Append Changelog"
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\n\nfor (const item of $input.all()) {\n  const filePath = `/path/to/vault/${item.json.filename}`;\n  fs.writeFileSync(filePath, item.json.content, 'utf8');\n}\n\nreturn $input.all();"
      },
