      "id": "99748b2a-a980-4614-978a-7652c1e9e1ec",
      "name": "OPNsense: Get DHCP Leases",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        32,
        320
      ],
    },
    {
      "parameters": {
        "jsCode": "const state = {\n  collected_at: new Date().toISOString(),\n  source: 'opnsense',\n  data: {\n    interfaces: {},\n    aliases: {},\n    routes: {},\n    dhcp_leases: {}\n  }\n};\n\ntry { state.data.interfaces = $('OPNsense: Get Interfaces').first().json; } catch(e) {}\ntry { state.data.aliases = $('OPNsense: Get Aliases').first().json; } catch(e) {}\ntry { state.data.routes = $('OPNsense: Get Routes').first().json; } catch(e) {}\ntry { state.data.dhcp_leases = $('OPNsense: Get DHCP Leases').first().json; } catch(e) {}\n\nreturn [{ json: state }];"
      },
      "id": "6707c9a7-ed19-4bfc-aaf0-00f2959a9ddf",
      "name": "Build State Object",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        16
      ]
    },
    {
      "parameters": {
        "fileSelector": "/path/to/vault/opnsense-state.json",
        "options": {}
      },
      "id": "b942887e-ef9f-4ec7-9311-dbdccb83503a",
      "name": "Read Previous State",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        608,
        272
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Compare current state with previous state to find changes\nconst current = $('Build State Object').first().json;\nlet previous = null;\n\ntry {\n  const prevData = $('Read Previous State').first();\n  if (prevData && prevData.json && prevData.json.data) {\n    previous = prevData.json;\n  }\n} catch (e) {\n  // No previous state exists, treat everything as new\n}\n\nconst diff = {\n  has_changes: false,\n  is_first_run: !previous,\n  changes: [],\n  current_state: current,\n  previous_collected_at: previous?.collected_at || null\n};\n\nif (!previous) {\n  diff.has_changes = true;\n  diff.changes.push('Initial topology scan — no previous state found');\n} else {\n  // Compare interfaces\n  const currIfaces = JSON.stringify(current.data.interfaces);\n  const prevIfaces = JSON.stringify(previous.data.interfaces);\n  if (currIfaces !== prevIfaces) {\n    diff.has_changes = true;\n    diff.changes.push('Interface configuration changed');\n  }\n\n  // Compare aliases\n  const currAliases = JSON.stringify(current.data.aliases);\n  const prevAliases = JSON.stringify(previous.data.aliases);\n  if (currAliases !== prevAliases) {\n    diff.has_changes = true;\n    diff.changes.push('Firewall aliases changed');\n  }\n\n  // Compare routes\n  const currRoutes = JSON.stringify(current.data.routes);\n  const prevRoutes = JSON.stringify(previous.data.routes);\n  if (currRoutes !== prevRoutes) {\n    diff.has_changes = true;\n    diff.changes.push('Routing table changed');\n  }\n\n  // Compare DHCP\n  const currDhcp = JSON.stringify(current.data.dhcp_leases);\n  const prevDhcp = JSON.stringify(previous.data.dhcp_leases);\n  if (currDhcp !== prevDhcp) {\n    diff.has_changes = true;\n    diff.changes.push('DHCP leases changed');\n  }\n}\n\nreturn [{ json: diff }];"
      },
      "id": "be2657dd-6279-499b-bab5-dc27fc10ad3e",
      "name": "Diff: Detect Changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.has_changes }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "id": "965052e6-a6a1-4723-80bc-4849e379222c"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b05f3bd2-3000-4080-8ee3-fff3e188cd91",
      "name": "Changes Detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.1,
      "position": [
        1104,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the prompt for Claude Code\nconst diff = $('Diff: Detect Changes').first().json;\nconst state = diff.current_state;\n\nconst prompt = `You are a network documentation assistant for a homelab environment.\n\nHere is the current infrastructure state collected from OPNsense:\n\n\\`\\`\\`json\n${JSON.stringify(state.data, null, 2)}\n\\`\\`\\`\n\nDetected changes since last scan:\n${diff.changes.map(c => '- ' + c).join('\\n')}\n\nPlease generate TWO outputs separated by the delimiter ===SPLIT===\n\nOUTPUT 1: A YAML file (opnsense.yml) representing the current OPNsense state in a NetBox-compatible schema. Include:\n- Device metadata (name, role, site, device_type)\n- All interfaces with their IPs, subnets, VLAN assignments, and status\n- Firewall aliases organized by type\n- Static routes\n- Active DHCP scopes with ranges\n\nOUTPUT 2: A Markdown document (opnsense.md) for the Obsidian vault. Include:\n- YAML frontmatter with tags, date, and aliases\n- Human-readable summary of the OPNsense configuration\n- Interface table (name, IP, VLAN, description)\n- Notable firewall aliases\n- DHCP scope summary\n- A \"Changes\" section noting what changed in this scan\n- Use wiki-links [[like this]] for cross-references to other homelab notes\n\nKeep the tone concise and technical. This is a homelab run by a network engineering student.`;\n\n// Escape for shell - replace single quotes\nconst escaped = prompt.replace(/'/g, \"'\\\\''\" );\n\nreturn [{ json: { prompt: escaped } }];"
      },
      "id": "ee177d09-d43f-4b26-bdd4-30fd56234a07",
      "name": "Build Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        16
      ]
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "command": "=/path/to/claude -p --dangerously-skip-permissions '{{ $json.prompt }}'",
        "cwd": "/home"
      },
      "id": "4ff622c2-0484-4750-8a7a-241094fe8bb7",
      "name": "SSH: Claude Code",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        1600,
        16
      ],
      "notes": "CONFIGURE: Update SSH credentials to use key-based auth. Set the host to your Claude Code VM IP."
    },
    {
      "parameters": {
        "jsCode": "// Split Claude's response into YAML and Markdown\nconst response = $json.stdout || $json.stderr || '';\nconst parts = response.split('===SPLIT===');\n\nconst yamlContent = (parts[0] || '').trim();\nconst mdContent = (parts[1] || '').trim();\n\n// Clean up any markdown code fences Claude might add\nconst cleanYaml = yamlContent\n  .replace(/^```ya?ml\\n?/gm, '')\n  .replace(/^```\\n?/gm, '')\n  .trim();\n\nconst cleanMd = mdContent\n  .replace(/^```markdown\\n?/gm, '')\n  .replace(/^```\\n?/gm, '')\n  .trim();\n\nreturn [\n  { json: { type: 'yaml', content: cleanYaml, filename: 'opnsense.yml' } },\n  { json: { type: 'markdown', content: cleanMd, filename: 'opnsense.md' } }\n];"
      },
      "id": "1dc51ae0-ec9e-4c1c-94ae-3cb883a1427c",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1856,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "// Generate changelog entry\nconst diff = $('Diff: Detect Changes').first().json;\nconst date = new Date().toISOString().split('T')[0];\nconst time = new Date().toISOString().split('T')[1].split('.')[0];\n\nconst entry = `\\n## ${date} ${time}\\n\\n${diff.changes.map(c => '- ' + c).join('\\n')}\\n`;\n\nreturn [{ json: { entry } }];"
      },
      "id": "d1133f9c-87e7-4a26-8305-0708d7c3e9b6",
      "name": "Build Changelog Entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        336
      ]
    },
    {
      "parameters": {},
      "id": "5944a8cb-b90b-493f-864a-35f9c82ffddf",
      "name": "No Changes — Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
