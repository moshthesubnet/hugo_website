    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst state = $('Build State Object').first().json;\n\nfs.writeFileSync(\n  '/path/to/vault/opnsense-state.json',\n  JSON.stringify(state, null, 2),\n  'utf8'\n);\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
